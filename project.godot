; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be manually edited.

[application]

config/name="Dating Sim"
config/description="A full-fledged dating simulation game"
config/version="1.0.0"
run/main_scene="res://source/scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

EventBus="*res://source/autoload/event_bus.gd"
GameState="*res://source/autoload/game_state.gd"
UIThemeManager="*res://source/autoload/ui_theme_manager.gd"
AffectionManager="*res://source/autoload/affection_manager.gd"
SaveManager="*res://source/autoload/save_manager.gd"
AudioManager="*res://source/autoload/audio_manager.gd"
TransitionManager="*res://source/autoload/transition_manager/transition_manager.gd"
SceneManager="*res://source/autoload/scene_manager.gd"
DialogueManager="*res://source/features/dialogue/dialogue_manager.gd"
PortraitManager="*res://source/features/characters/portrait_manager.gd"
GalleryManager="*res://source/features/gallery/gallery_manager.gd"
MinigameManager="*res://source/features/minigames/minigame_manager.gd"
RouteManager="*res://source/features/romance/route_manager.gd"
TimeManager="*res://source/features/time/time_manager.gd"
CheatManager="*res://source/autoload/cheat_manager.gd"
DayNightManager="*res://source/autoload/day_night_manager.gd"
TouchInputManager="*res://source/autoload/touch_input_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/aspect_ratio=1.7778
window/handheld/orientation=0

